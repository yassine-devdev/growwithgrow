{
  "dashboard": {
    "id": null,
    "title": "Business Metrics",
    "tags": ["business", "metrics", "kpi"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "User Registrations (24h)",
        "type": "stat",
        "targets": [
          {
            "expr": "increase(user_registrations_total[24h])",
            "legendFormat": "New Users"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {
              "mode": "palette-classic"
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "User Logins (24h)",
        "type": "stat",
        "targets": [
          {
            "expr": "increase(user_logins_total[24h])",
            "legendFormat": "Logins"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {
              "mode": "palette-classic"
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 6,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "AI Tokens Used (24h)",
        "type": "stat",
        "targets": [
          {
            "expr": "increase(ai_tokens_used_total[24h])",
            "legendFormat": "Tokens"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {
              "mode": "palette-classic"
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": 4,
        "title": "AI Cost (24h)",
        "type": "stat",
        "targets": [
          {
            "expr": "increase(ai_cost_estimate_total[24h])",
            "legendFormat": "Cost USD"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "color": {
              "mode": "palette-classic"
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 18,
          "y": 0
        }
      },
      {
        "id": 5,
        "title": "User Registration Trend",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(user_registrations_total[1h])",
            "legendFormat": "{{source}} - {{plan_type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        }
      },
      {
        "id": 6,
        "title": "Feature Usage",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(feature_usage_total[1h])",
            "legendFormat": "{{feature}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        }
      },
      {
        "id": 7,
        "title": "AI Usage by Provider",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum by (provider) (increase(ai_requests_total[24h]))",
            "legendFormat": "{{provider}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 0,
          "y": 16
        }
      },
      {
        "id": 8,
        "title": "AI Cost by Provider",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum by (provider) (increase(ai_cost_estimate_total[24h]))",
            "legendFormat": "{{provider}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 8,
          "y": 16
        }
      },
      {
        "id": 9,
        "title": "WebSocket Connections",
        "type": "timeseries",
        "targets": [
          {
            "expr": "websocket_connections_active",
            "legendFormat": "Active Connections"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 16,
          "y": 16
        }
      }
    ],
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "refresh": "1m",
    "schemaVersion": 27,
    "version": 1,
    "links": []
  }
}