{
  "name": "cyberpunk-hud-interface",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm dev:client\" \"pnpm dev:server\" --names \"CLIENT,SERVER\" --prefix-colors \"cyan,magenta\"",
    "dev:client": "vite --port 3000",
    "dev:server": "pnpm --filter backend dev",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build",
    "build:server": "pnpm --filter backend build",
    "build:prod": "vite build --config vite.config.prod.ts --mode production",
    "build:analyze": "pnpm build:prod && echo 'Bundle analysis available at dist/stats.html'",
    "build:size": "pnpm build:prod && du -sh dist/* | sort -hr",
    "preview": "vite preview",
    "serve": "vite preview --port 5176",
    "type-check": "tsc --noEmit",
    "lint": "echo 'Linting not configured yet'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:security": "playwright test tests/security",
    "test:accessibility": "playwright test tests/accessibility",
    "test:performance": "artillery run tests/performance/load-testing.yml",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:security && npm run test:accessibility",
    "security:scan": "node scripts/security-scan.js scan",
    "security:npm": "node scripts/security-scan.js npm",
    "security:snyk": "node scripts/security-scan.js snyk",
    "security:licenses": "node scripts/security-scan.js licenses",
    "security:fix": "node scripts/security-scan.js fix",
    "security:monitor": "snyk monitor",
    "build:optimize": "node scripts/build-optimization.js build",
    "build:analyze-only": "node scripts/build-optimization.js analyze",
    "build:clean": "node scripts/build-optimization.js clean",
    "build:force": "node scripts/build-optimization.js force",
    "deploy:blue-green": "node scripts/blue-green-deploy.js deploy",
    "deploy:rollback": "node scripts/blue-green-deploy.js rollback",
    "deploy:status": "node scripts/blue-green-deploy.js status",
    "deploy:cleanup": "node scripts/blue-green-deploy.js cleanup",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "env:list": "node scripts/env-manager.js list",
    "env:current": "node scripts/env-manager.js current",
    "env:switch": "node scripts/env-manager.js switch",
    "env:validate": "node scripts/env-manager.js validate",
    "env:compare": "node scripts/env-manager.js compare",
    "env:promote": "node scripts/env-manager.js promote",
    "migration:backup": "node scripts/migration-automation.js backup",
    "migration:status": "node scripts/migration-automation.js status",
    "migration:run": "node scripts/migration-automation.js migrate",
    "migration:rollback": "node scripts/migration-automation.js rollback",
    "migration:validate": "node scripts/migration-automation.js validate",
    "migration:plan": "node scripts/migration-automation.js plan",
    "monitoring:setup": "node scripts/setup-monitoring.js",
    "monitoring:start": "docker-compose -f docker-compose.monitoring.yml up -d",
    "monitoring:stop": "docker-compose -f docker-compose.monitoring.yml down",
    "monitoring:logs": "docker-compose -f docker-compose.monitoring.yml logs -f",
    "monitoring:restart": "docker-compose -f docker-compose.monitoring.yml restart",
    "monitoring:status": "docker-compose -f docker-compose.monitoring.yml ps",
    "perf:optimize": "node scripts/performance-optimization.js full",
    "perf:frontend": "node scripts/performance-optimization.js frontend",
    "perf:backend": "node scripts/performance-optimization.js backend",
    "perf:database": "node scripts/performance-optimization.js database",
    "perf:report": "node scripts/performance-optimization.js report",
    "agent": "node cli-agent/multiverse-agent-simple.js",
    "agent:status": "node cli-agent/multiverse-agent-simple.js --status",
    "agent:analyze": "node cli-agent/multiverse-agent-simple.js --analyze",
    "agent:continuous": "node cli-agent/multiverse-agent-simple.js --continuous",
    "agent:work": "node cli-agent/working-agent.js --run"
  },
  "dependencies": {
    "@google/genai": "^1.13.0",
    "@prisma/client": "^6.14.0",
    "@tanstack/react-query": "^5.59.0",
    "@trpc/client": "^11.4.4",
    "@trpc/react-query": "^11.4.4",
    "@trpc/server": "^11.4.4",
    "automata": "^3.0.4",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "html-to-image": "^1.11.11",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.5",
    "prisma": "^6.14.0",
    "prom-client": "^15.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-rnd": "^10.5.2",
    "recharts": "^3.1.2",
    "tailwind-merge": "^2.4.0",
    "web-vitals": "^5.1.0",
    "winston": "^3.17.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@playwright/test": "^1.49.1",
    "@axe-core/playwright": "^4.10.2",
    "artillery": "^2.0.20",
    "jsdom": "^25.0.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "snyk": "^1.1293.1",
    "terser": "^5.43.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  }
}
