# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.0

# Ignore specific vulnerabilities (add as needed)
ignore: {}

# Language settings
language-settings:
  javascript:
    # Ignore dev dependencies in production scans
    ignore-dev-deps: true
    
# Patch settings
patch: {}

# Monitor settings for continuous monitoring
monitor:
  # Monitor production dependencies
  production-deps: true
  # Monitor dev dependencies
  dev-deps: false