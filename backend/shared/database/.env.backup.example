# Backup System Configuration
# Copy this file to .env.backup and configure for your environment

# Backup Storage Configuration
BACKUP_PATH=/var/backups/app
BACKUP_RETENTION_DAYS=30
BACKUP_TIME=02:00

# Backup Features
BACKUP_COMPRESSION=true
BACKUP_ENCRYPTION=false
BACKUP_ENCRYPTION_KEY=your-32-character-encryption-key-here
BACKUP_VERIFICATION=true

# Notification Configuration
BACKUP_NOTIFICATION_EMAILS=admin@yourcompany.com,dba@yourcompany.com

# AWS S3 Configuration (Optional)
AWS_S3_BACKUP_BUCKET=your-backup-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/production

# Monitoring Configuration
BACKUP_HEALTH_CHECK_INTERVAL=3600000
BACKUP_ALERT_WEBHOOK_URL=https://hooks.slack.com/your-webhook-url

# Recovery Objectives
BACKUP_RTO_TARGET_MINUTES=30
BACKUP_RPO_TARGET_MINUTES=60

# Advanced Configuration
BACKUP_PARALLEL_JOBS=2
BACKUP_TEMP_PATH=/tmp/backups
BACKUP_LOG_LEVEL=info
BACKUP_MAX_BACKUP_SIZE_GB=100