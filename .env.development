# Development Environment Configuration

# Frontend
VITE_APP_TITLE="Grow Your Need - Development"
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:3001

# Backend (Encore.ts will use these)
NODE_ENV=development
PORT=4000
WS_PORT=3001

# CORS Origins for development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://localhost:3000,https://localhost:5173

# Database (if using local database)
DATABASE_URL="postgresql://localhost:5432/growyourneed_dev"

# AI Services (add your API keys)
OPENAI_API_KEY=your_openai_key_here
GOOGLE_AI_API_KEY=your_google_ai_key_here

# Security (development keys - change in production)
JWT_SECRET=dev_jwt_secret_change_in_production
ENCRYPTION_KEY=dev_encryption_key_change_in_production