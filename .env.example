# AI Provider Configuration
# Copy this file to .env and fill in your API keys

# OpenRouter API Key (for access to multiple AI models)
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini API Key
VITE_GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Ollama Configuration (for local AI models)
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_ENABLED=true

# Default AI Provider (openrouter, ollama, or gemini)
VITE_DEFAULT_AI_PROVIDER=openrouter

# Application Configuration
VITE_APP_NAME=Grow Your Need SaaS
VITE_APP_URL=http://localhost:5176

# tRPC Configuration
VITE_TRPC_HTTP_URL=http://localhost:4000/trpc
VITE_TRPC_WS_URL=ws://localhost:3001

# AI Usage Tracking
VITE_TRACK_AI_USAGE=true
VITE_AI_DAILY_COST_LIMIT=10
VITE_AI_MONTHLY_COST_LIMIT=100

# Production Settings
VITE_NODE_ENV=development